  "artists": [
    {
      "id": "lumen-fields",
      "name": "Lumen Fields",
      "genre": "Ambient / Electronic",
      "city": "Portland",
      "bio": "Two synths, one tape loop and a lot of Pacific fog. Lumen Fields build slow-moving electronic pieces that feel less like songs and more like weather systems arriving over the coast.",
      "albums": ["tidal-motions", "glass-hour"]
    },
    {
      "id": "mireille",
      "name": "Mireille",
      "genre": "Neoclassical",
      "city": "Antwerp",
      "bio": "Mireille writes small, careful piano pieces in an attic studio above a canal. Her records are quiet, deliberate and largely recorded in single takes at dawn.",
      "albums": ["vestige"]
    },
    {
      "id": "cosmonaut-echo",
      "name": "Cosmonaut Echo",
      "genre": "Synthwave",
      "city": "Berlin",
      "bio": "A one-woman mission control in Kreuzberg. Cosmonaut Echo makes late-night synthwave with the air pressure of a spacecraft about to leave orbit.",
      "albums": ["pale-blue-night"]
    },
    {
      "id": "halftone",
      "name": "Halftone",
      "genre": "Lo-Fi",
      "city": "Copenhagen",
      "bio": "Halftone press an old Wurlitzer into service over dusty drum machines. Home-recorded, slightly off tape, and made for coffee that is already cold.",
      "albums": ["sunday-paper", "slow-canyons"]
    },
    {
      "id": "odessa-bloom",
      "name": "Odessa Bloom",
      "genre": "Downtempo",
      "city": "Lisbon",
      "bio": "Odessa Bloom mixes field recordings of the Tagus river with drifting chord beds. Her music measures time in the movement of ferries.",
      "albums": ["ferry-light"]
    },
    {
      "id": "paper-foxes",
      "name": "The Paper Foxes",
      "genre": "Indie Folk",
      "city": "Galway",
      "bio": "Two siblings, a borrowed banjo and harmonies learned in car parks. The Paper Foxes make weathered folk that sounds older than it is.",
      "albums": ["borderlands"]
    },
    {
      "id": "shogun-mono",
      "name": "Shōgun Mono",
      "genre": "Ambient Electronica",
      "city": "Kyoto",
      "bio": "Shōgun Mono layers bamboo flute samples over field recordings of rain on temple roofs. Headphone music, best at dusk.",
      "albums": ["kite-season"]
    },
    {
      "id": "violet-meridian",
      "name": "Violet Meridian",
      "genre": "Dream Pop",
      "city": "Reykjavík",
      "bio": "Slow, reverb-drenched songs from the edge of the map. Violet Meridian records guitar and voice and lets the Icelandic winter do the rest.",
      "albums": ["pale-fire"]
    },
    {
      "id": "backyard-circuit",
      "name": "Backyard Circuit",
      "genre": "Indie Electronic",
      "city": "Austin",
      "bio": "Backyard Circuit build small electronic anthems from garage recordings and cheap sequencers. Maximal melody, minimal gear.",
      "albums": ["kaleidoscope", "circuitry"]
    }
  ],
